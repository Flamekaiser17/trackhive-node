{
  "name": "trackhive2",
  "version": "1.0.0",
  "description": "TrackHive - Real-time Fleet & Delivery Orchestration Engine Monorepo",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "start": "npm start --prefix apps/backend",
    "dev": "npm run dev --prefix apps/backend",
    "dev:backend": "npm run dev --prefix apps/backend",
    "dev:frontend": "npm run dev --prefix apps/frontend",
    "build:frontend": "npm run build --prefix apps/frontend",
    "test:load": "npm run test:load --prefix apps/backend",
    "prisma:generate": "npm run prisma:generate --prefix apps/backend",
    "prisma:push": "npm run prisma:push --prefix apps/backend"
  }
}
